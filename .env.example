# Database Configuration
# PostgreSQL connection settings
POSTGRES_USER=analytics
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Airflow Configuration
# User ID for Airflow (run: echo -e "AIRFLOW_UID=$(id -u)" >> .env)
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKEND=airflow.api.auth.backend.basic_auth

# Metabase Configuration
METABASE_SITE_NAME=E-Commerce Analytics
METABASE_DB_TYPE=postgres
METABASE_DB_DBNAME=ecommerce
METABASE_DB_PORT=5432
METABASE_DB_USER=analytics
METABASE_DB_PASS=your_password_here
METABASE_DB_HOST=postgres

# Don't commit this file! Copy to .env and fill in your values
# Run: cp .env.example .env
